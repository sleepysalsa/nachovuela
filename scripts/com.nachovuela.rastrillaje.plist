<?xml version="1.0" encoding="UTF-8"?>
<!--
  Corridas COMPLETAS de NachoVuela (radar + buscador ida+vuelta + apertura +
  clima + ofertas). Dos por día: 11:00 y 17:00.

  Antes eran 9:00 y 20:00, dos horarios en los que la Mac suele estar cerrada:
  el completo de las 20:00 terminaba a las 11 de la mañana siguiente y de paso
  bloqueaba al de las 9:00 (launchd no larga otra instancia del mismo label
  mientras la vieja sigue viva). En data/rastrillaje.log, sobre los 7 días
  completos que hay registrados (1 al 7-sep-2026), el turno de las 9:00 arrancó
  4 veces y el de las 12:00 los 7: los completos se mudan a esa franja.

  OJO: esto es una PLANTILLA. __RUTA__ se reemplaza al instalar.
  Instalación: ver scripts/agendar.md
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nachovuela.rastrillaje</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RUTA__/scripts/run.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>__RUTA__/data/rastrillaje.log</string>
  <key>StandardErrorPath</key>
  <string>__RUTA__/data/rastrillaje.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
